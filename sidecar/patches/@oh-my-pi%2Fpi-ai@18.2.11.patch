+import type { FetchImpl, ProviderAttemptObservation, ProviderAttemptCounters, StreamOptions } from "../types";
+
+/** One physical dispatch. Observers cannot change provider control flow. */
+export function beginProviderAttempt(observer?: StreamOptions["onProviderAttempt"]) {
+ const event: ProviderAttemptObservation = { id: crypto.randomUUID(), state: "started", startedAt: new Date().toISOString(), counters: {} };
+ let settled = false;
+ const emit = (value: ProviderAttemptObservation) => {
+  try { observer?.(structuredClone(value)); } catch { /* Accounting errors never retry a request. */ }
+ };
+ emit(event);
+ return {
+  requestId(value: string | undefined) { event.requestId = value; },
+  protocol(contextTokens?: number, tokenDelta?: number) {
+   if (settled) return;
+   if (contextTokens !== undefined) event.contextTokens = contextTokens;
+   if (tokenDelta !== undefined) event.protocolTokenDeltaTotal = Number.isSafeInteger(tokenDelta) && tokenDelta >= 0
+    ? (event.protocolTokenDeltaTotal ?? 0) + tokenDelta : Number.NaN;
+  },
+  counters(): ProviderAttemptCounters { return { ...event.counters }; },
+  observe(counters: ProviderAttemptCounters, responseId?: string, replace = false) {
+   if (settled) return;
+   event.counters = replace ? { ...counters } : { ...event.counters, ...counters };
+   if (responseId) event.responseId = responseId;
+  },
+  finish(state: "completed" | "failed" | "cancelled") {
+   if (settled) return;
+   settled = true;
+   emit({ ...event, state, finishedAt: new Date().toISOString() });
+  },
+ };
+}
+
+/** Observation only: never consumes a body or changes retries/dispatch. */
+export function providerAttempts(options?: StreamOptions) {
+ const pending = new Map<Response, ReturnType<typeof beginProviderAttempt>>();
+ const finish = (response: Response, state: "completed" | "failed" | "cancelled") => {
+  const attempt = pending.get(response);
+  if (!attempt) return;
+  pending.delete(response); attempt.finish(state);
+ };
+ return {
+  wrapFetch(fetchImpl: FetchImpl | undefined): FetchImpl | undefined {
+   if (!options?.onProviderAttempt) return fetchImpl;
+   return (async (input, init) => {
+    const attempt = beginProviderAttempt(options.onProviderAttempt);
+    try {
+     const response = await (fetchImpl ?? globalThis.fetch)(input, init);
+     attempt.requestId(response.headers.get("request-id") ?? response.headers.get("x-request-id") ?? undefined);
+     pending.set(response, attempt);
+     if (!response.ok) finish(response, "failed");
+     return response;
+    } catch (error) {
+     attempt.finish(init?.signal?.aborted ? "cancelled" : "failed");
+     throw error;
+    }
+   }) as FetchImpl;
+  },
+  counters(response: Response | undefined): ProviderAttemptCounters {
+   return response ? pending.get(response)?.counters() ?? {} : {};
+  },
+  observe(response: Response | undefined, counters: ProviderAttemptCounters, responseId?: string, replace = false) {
+   if (response) pending.get(response)?.observe(counters, responseId, replace);
+  },
+  finish,
+  close(state: "completed" | "failed" | "cancelled") {
+   for (const response of pending.keys()) finish(response, state);
+  },
+ };
+}
