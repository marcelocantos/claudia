index 0000000000000000000000000000000000000000..817816aacc6babcb3ba34780331d2e768031fa43
--- /dev/null
+++ b/src/utils/provider-attempt.ts
@@ -0,0 +1,47 @@
+import type { FetchImpl, ProviderAttemptObservation, ProviderAttemptCounters, StreamOptions } from "../types";
+
+/** Observation only: never consumes a body or changes retries/dispatch. */
+export function providerAttempts(options?: StreamOptions) {
+	const pending = new Map<Response, ProviderAttemptObservation>();
+	const emit = (event: ProviderAttemptObservation) => {
+		try { options?.onProviderAttempt?.(structuredClone(event)); } catch { /* Observer failure cannot retry a request. */ }
+	};
+	const finish = (response: Response, state: "completed" | "failed" | "cancelled") => {
+		const event = pending.get(response);
+		if (!event) return;
+		pending.delete(response);
+		emit({ ...event, state, finishedAt: new Date().toISOString() });
+	};
+	return {
+		wrapFetch(fetchImpl: FetchImpl | undefined): FetchImpl | undefined {
+			if (!options?.onProviderAttempt) return fetchImpl;
+			return (async (input, init) => {
+				const event: ProviderAttemptObservation = { id: crypto.randomUUID(), state: "started", startedAt: new Date().toISOString(), counters: {} };
+				emit(event);
+				try {
+					const response = await (fetchImpl ?? globalThis.fetch)(input, init);
+					event.requestId = response.headers.get("request-id") ?? response.headers.get("x-request-id") ?? undefined;
+					pending.set(response, event);
+					if (!response.ok) finish(response, "failed");
+					return response;
+				} catch (error) {
+					emit({ ...event, state: init?.signal?.aborted ? "cancelled" : "failed", finishedAt: new Date().toISOString() });
+					throw error;
+				}
+			}) as FetchImpl;
+		},
+		counters(response: Response | undefined): ProviderAttemptCounters {
+			return { ...(response && pending.get(response)?.counters) };
+		},
+		observe(response: Response | undefined, counters: ProviderAttemptCounters, responseId?: string, replace = false) {
+			const event = response && pending.get(response);
+			if (!event) return;
+			event.counters = replace ? { ...counters } : { ...event.counters, ...counters };
+			if (responseId) event.responseId = responseId;
+		},
+		finish,
+		close(state: "completed" | "failed" | "cancelled") {
+			for (const response of pending.keys()) finish(response, state);
+		},
+	};
+}
