#!/bin/sh
# Pre-push: basic sanity, then check that `make gate` attested the tree
# being pushed. The hook does not run the gate. It used to: the gate takes
# ~25 minutes, git opens the SSH connection before the hook, and GitHub
# closes an idle connection long before the gate finishes — two pushes on
# 2026-09-22 ran the whole gate green and then died with "Connection to
# ssh.github.com closed by remote host", having pushed nothing.
#
# The gate is the oracle and writes .git/gate-attestation when it passes
# (scripts/gate-attest.sh). This hook only checks that the attestation is
# current for the tip of each ref being pushed — only the tip; the commits
# behind it are not checked. The attestation stays in .git/, never
# committed. Agents must not pass --no-verify. Owner emergency bypass is
# git push --no-verify.
#
# WIP backups are exempt: a ref pushed to a remote ref under refs/backup/
# (~/bin/backup-branches.sh mirrors every local branch to
# refs/backup/<host>/<branch>) is not a release and no consumer builds it,
# so it needs neither build + vet nor an attestation. Every other remote
# ref is checked exactly as before, including in a push that mixes the two.
# internal/prepush pins this behaviour.
set -eu
cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000

# git hands the hook one line per ref: <local ref> <local sha> <remote ref>
# <remote sha>. A delete has an all-zero local sha. Read them all first:
# whether to build and check at all depends on every line.
refs=$(cat)
checked=""   # local shas whose tree must match the attestation
strict=0     # any non-backup ref in this push (or no refs at all)
[ -z "$refs" ] && strict=1
nl='
'
oldifs=$IFS
IFS=$nl
for line in $refs; do
    IFS=$oldifs
    # shellcheck disable=SC2086
    set -- $line
    IFS=$nl
    local_sha=${2:-}
    remote_ref=${3:-}
    case "$remote_ref" in
        refs/backup/*) continue ;;
    esac
    strict=1
    [ "$local_sha" = "$zero" ] && continue # a branch delete pushes nothing
    checked="$checked $local_sha"
done
IFS=$oldifs

if [ "$strict" = 0 ]; then
    echo "✓ refs/backup/* only — WIP backup, build + vet and gate attestation skipped"
    exit 0
fi

go build ./... && go vet ./... && echo "✓ build + vet"

att="$(git rev-parse --git-dir)/gate-attestation"
if [ ! -f "$att" ]; then
    echo "pre-push: no gate attestation in this clone — run make gate, then push" >&2
    exit 1
fi
tree=$(sed -n 's/^tree=//p' "$att")
dirty=$(sed -n 's/^dirty=//p' "$att")
at=$(sed -n 's/^at=//p' "$att")
if [ "${dirty:-1}" != "0" ]; then
    echo "pre-push: the last make gate ran on a tree with $dirty uncommitted change(s) at $at — commit, run make gate, then push" >&2
    exit 1
fi

for local_sha in $checked; do
    pushed_tree=$(git rev-parse "$local_sha^{tree}")
    if [ "$pushed_tree" != "$tree" ]; then
        echo "pre-push: make gate last attested tree $tree at $at; you are pushing $(git rev-parse --short "$local_sha") whose tree is $pushed_tree — run make gate on this commit, then push" >&2
        exit 1
    fi
done
echo "✓ gate attestation covers the pushed tree ($at)"
